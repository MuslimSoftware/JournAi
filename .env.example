# Google Drive OAuth
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Application type: "Desktop app" (required — enables PKCE + client secret without a web server)
# Add both redirect URIs in Google Cloud Console:
#   http://127.0.0.1:53683/sync/oauth/callback  (desktop)
#   journai://sync/oauth/callback               (iOS/Android)
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_CLIENT_SECRET=
VITE_GOOGLE_DRIVE_REDIRECT_URI=   # optional — defaults to platform-appropriate URI above
